@@ -0,0 +1,25 @@
+// r4d_gdn_fused_update_w4k128v128_bf16.hip -- the fused GDN decode step against an **fp32** paged
+// state cache: conv update -> grid barrier -> recurrent update, in ONE launch.
+//
+// This is the single-sequence path (the dispatcher routes nseq*H > 32 to the conv+recurrent pair,
+// whose resident 32-workgroup grid it would otherwise work-loop). The kernel lives in
+// r4d_gdn_fused_update_w4k128v128.h; this unit instantiates it for the fp32 state.
+//
+// NOTE the entry point keeps its original, state-dtype-free name so existing callers and benches
+// that hardcode it keep working; the bf16 sibling is spelled ..._bf16_bf16state. The registry
+// still constrains state_dtype on BOTH rows, so select() cannot hand a caller the wrong one.
+#include "r4d_gdn_fused_update_w4k128v128.h"
+
+extern "C" int r4d_gdn_fused_update_w4k128v128_bf16(
+
+    const void* x, long xpitch, const void* wgt, const void* bias, void* cstate,
+    long cs_seq, long cs_dim, long cs_tok, int state_len_max, const void* cache_idx,
+    long ci_stride, const void* num_accepted, const void* cu, int N, int H, int Hg,
+    int K, int V, int width, int max_query_len, void* q, void* k, void* v,
+    const void* a, const void* b, long ab_stride, int ab_is_bf16,
+    const void* A_log, const void* dt_bias, void* state, long st_slot, long st_head,
+    void* o, const void* sidx, long sidx_stride, float scale, float softplus_thr,
+    void* barrier_cnt, int o_rows, void* stream)
+{
+  return fu_launch<R4D_ST_F32>(x, xpitch, wgt, bias, cstate, cs_seq, cs_dim, cs_tok, state_len_max, cache_idx, ci_stride, num_accepted, cu, N, H, Hg, K, V, width, max_query_len, q, k, v, a, b, ab_stride, ab_is_bf16, A_log, dt_bias, state, st_slot, st_head, o, sidx, sidx_stride, scale, softplus_thr, barrier_cnt, o_rows, stream);
+}
