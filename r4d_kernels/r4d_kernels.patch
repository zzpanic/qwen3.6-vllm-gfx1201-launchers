+// r4d_gdn_lazy_update_k128_v128_bf16_bf16state.hip -- lazy-snapshot GDN decode update, bf16state cache.
+// See r4d_gdn_lazy_update_k128_v128.h and r4d_gdn_state.h.
+#include "r4d_gdn_lazy_update_k128_v128.h"
+
+extern "C" int r4d_gdn_lazy_update_k128_v128_bf16_bf16state(
+    const void* q, const void* k, const void* v, const void* a, const void* b,
+    long ab_stride, int ab_is_bf16, const void* A_log, const void* dt_bias, void* state,
+    long state_slot_stride, long state_head_stride, void* o, const void* cu,
+    const void* ssm_state_indices, long indices_stride, const void* num_accepted,
+    int N, int H, int Hg, int K, int V, int stash_col, float scale, float softplus_thr,
+    void* stream)
+{
+  return lz_launch<R4D_ST_BF16>(q, k, v, a, b, ab_stride, ab_is_bf16, A_log, dt_bias, state,
+                       state_slot_stride, state_head_stride, o, cu, ssm_state_indices,
+                       indices_stride, num_accepted, N, H, Hg, K, V, stash_col, scale,
+                       softplus_thr, stream);
+}
+
+extern "C" int r4d_gdn_lazy_materialize_k128_v128_bf16_bf16state(
+    const void* state_ptrs, const void* slot_strides, const void* group_idx,
+    const void* alog_ptrs, const void* dtb_ptrs, const void* bt_ptrs, long bt_stride_req,
+    const void* idx_mapping, int mode, const void* state_idx, const void* src_col,
+    const void* token_bias, const void* num_accepted, const void* new_computed,
+    int block_size, int num_reqs, int n_states, int H, int Hg, int K, int V, long st_head,
+    float scale, float softplus_thr, void* stream)
+{
+  return lz_materialize_launch<R4D_ST_BF16>(state_ptrs, slot_strides, group_idx, alog_ptrs, dtb_ptrs,
+                                   bt_ptrs, bt_stride_req, idx_mapping, mode, state_idx, src_col,
+                                   token_bias, num_accepted, new_computed, block_size, num_reqs,
+                                   n_states, H, Hg, K, V, st_head, scale, softplus_thr, stream);
+}
+
+// rx14: this unit's stale-stash counters (see r4d_gdn_lazy_update_k128_v128.h).
+extern "C" int r4d_gdn_lazy_stale_counts_bf16state(unsigned int* out4, int reset)
+{
+  return lz_stale_read(out4, reset);
+}
