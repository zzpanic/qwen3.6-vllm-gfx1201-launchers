[Unit]
Description=Periodic reap of the vLLM fs KV secondary tier
Documentation=https://github.com/zzpanic/qwen3.6-vllm-gfx1201-launchers/blob/master/kv-cache/README.md

[Timer]
# Every minute keeps each reap small and its I/O idle-class: under agentic load the tier can
# write tens of GB in minutes, and a slower cadence lets one reap become a large stall.
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
