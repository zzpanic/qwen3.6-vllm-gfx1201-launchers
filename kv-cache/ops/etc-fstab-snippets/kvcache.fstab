# /etc/fstab additions for the KV offload tiers. Both are preconditions, not tuning.

# 1. /dev/shm holds the CPU primary tier (--kv-offloading-size). The kernel default
#    is 50% of RAM = 15.67 GiB on the 31.34 GiB VM, which is BELOW the 16 GiB the
#    27b entry asks for. The region is pre-faulted, so an overshoot fails the boot
#    with no log line. 20G leaves margin above the 16 GiB tier.
tmpfs /dev/shm tmpfs rw,nosuid,nodev,inode64,size=20G 0 0

# 1a. AFTER THE +8 GB UPGRADE (planned 2026-09-08, 32 GB -> 40 GB), replace the line
#     above with:
#
#       tmpfs /dev/shm tmpfs rw,nosuid,nodev,inode64,size=28G 0 0
#
#     and raise the tier in config.yaml to "--kv-offloading-size 24".
#     The arithmetic, from `free -m` on 2026-09-08 with the 16 GiB tier resident:
#       total 32090 MB, used 22687, of which shared (the tier) 16728
#       => everything that is NOT the tier uses ~5960 MB.
#     On 40 GB: 39.2 GiB usable - 6 GiB other - 24 GiB tier = ~9 GiB headroom, which
#     is roughly what the box runs with today. The tier is the only cache tier that
#     beats recompute (11+ GB/s vs the fs tier's 1.16x), so spare RAM belongs here.
#     Capacity at the measured 33,808 B/token: 508k -> 762k tokens, ~13 -> ~20 prompts
#     of 34k. Keep shm 4 GiB above the tier: the region is pre-faulted and the launcher
#     only requires tier+0.25, which is too thin to absorb other /dev/shm users.
#     DO NOT raise the tier without raising shm first -- an overshoot fails the START
#     with no log line. Verify with statvfs, never df:
#       python3 -c "import os;s=os.statvfs('/dev/shm');print(s.f_blocks*s.f_frsize/2**30)"

# 2. The 512 GB zvol dpool/virtual/llama-cache, holding the fs secondary tier.
#    BY LABEL, NOT BY DEVICE: attaching this zvol renamed the root disk vda -> vdb
#    on the 2026-09-07 reboot. A /dev/vdX line here would be a future unbootable box.
#    noatime: the reaper keys on mtime, so atime buys nothing and costs a write per
#    read on the array. nofail: a detached disk must not wedge the boot.
LABEL=kvcache /kvcache ext4 noatime,nodiratime,nofail 0 2
