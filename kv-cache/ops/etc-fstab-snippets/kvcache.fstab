# /etc/fstab lines for the KV offload tiers. Preconditions, not tuning.

# 1. /dev/shm holds the RAM tier (--kv-offloading-size). NEEDED BY BOTH BUILDS.
#    The RAM tier is 16 GiB by default (docs/SETUP.md -> Sizing), so make /dev/shm 20G.
#    The kernel default is 50% of RAM, which is often below the tier. The region is pre-faulted, so
#    a tier that does not fit fails the START with no log line -- the launcher's
#    tier-size check (KVCACHE_TIER_GIB) catches this and disables offload rather than try.
#    Verify with statvfs, never df (df rounds a tmpfs UP):
#      python3 -c "import os;s=os.statvfs('/dev/shm');print(s.f_blocks*s.f_frsize/2**30)"
tmpfs /dev/shm tmpfs rw,nosuid,nodev,inode64,size=20G 0 0

# 2. DISK TIER on a filesystem of its own (optional; a folder with KVCACHE_MAX_GB also works).
#    BY LABEL, NOT BY DEVICE: attaching a second virtual disk can rename the root disk
#    (vda -> vdb here on 2026-09-07), and a /dev/vdX line would then be an unbootable box.
#    noatime: the reaper keys on mtime, so atime buys nothing and costs a write per read.
#    nofail: a detached disk must not wedge the boot.
LABEL=kvcache /kvcache ext4 noatime,nodiratime,nofail 0 2
